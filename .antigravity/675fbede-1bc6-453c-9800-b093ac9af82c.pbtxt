        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Camera-space corners"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val c_b0 = camera.toCameraSpace(b.x - halfW, 0f, b.z - halfL)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val c_b1 = camera.toCameraSpace(b.x + halfW, 0f, b.z - halfL)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val c_b2 = camera.toCameraSpace(b.x + halfW, 0f, b.z + halfL)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val c_b3 = camera.toCameraSpace(b.x - halfW, 0f, b.z + halfL)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val c_t0 = camera.toCameraSpace(b.x - halfW, b.height, b.z - halfL)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val c_t1 = camera.toCameraSpace(b.x + halfW, b.height, b.z - halfL)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val c_t2 = camera.toCameraSpace(b.x + halfW, b.height, b.z + halfL)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val c_t3 = camera.toCameraSpace(b.x - halfW, b.height, b.z + halfL)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        if (c_b0.z < 0.35f && c_b1.z < 0.35f && c_b2.z < 0.35f && c_b3.z < 0.35f) return"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Clamp near z"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        fun clampPt(v: Vector3) = if (v.z < 0.35f) Vector3(v.x, v.y, 0.35f) else v"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val b0 = camera.projectCameraPoint(clampPt(c_b0), w, h)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val b1 = camera.projectCameraPoint(clampPt(c_b1), w, h)"
