          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            color = fur.secondaryColor,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            radius = scale * 0.045f,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
