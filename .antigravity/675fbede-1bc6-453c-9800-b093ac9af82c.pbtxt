          text: "        val baseScreen = camera.project(x, 0f, z, w, h)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        if (!baseScreen.isVisible) return"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
