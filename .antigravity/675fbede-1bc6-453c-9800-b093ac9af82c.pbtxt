        lines {
          text: "        val windowColor = if (isNight) Color(0xFFFDE047) else Color(0x99BAE6FD)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val winCenter = camera.project(b.x, b.height * 0.45f, b.z + halfL + 0.1f, w, h)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        if (winCenter.isVisible) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val winW = (b2.x - b3.x).coerceAtLeast(10f) * 0.25f"
