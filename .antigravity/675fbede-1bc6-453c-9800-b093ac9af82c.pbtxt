          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                drawScope.drawLine(Color(0xFFCBD5E1), Offset(p2.x, p2.y), Offset(p3.x, p3.y), strokeWidth = 2.5f)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
