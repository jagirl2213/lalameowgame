          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val cPt = camera.toCameraSpace(dotX, 0.15f, dotZ)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
