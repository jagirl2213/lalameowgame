          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                val w1_tr = Offset(p0.x + (p1.x - p0.x) * 0.42f + (pTop0.x - p0.x) * hRatio1, p0.y + (p1.y - p0.y) * 0.42f + (pTop0.y - p0.y) * hRatio1)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                val w1_tl = Offset(p0.x + (p1.x - p0.x) * 0.2f + (pTop0.x - p0.x) * hRatio1, p0.y + (p1.y - p0.y) * 0.2f + (pTop0.y - p0.y) * hRatio1)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                val win1Path = Path().apply {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    moveTo(w1_b.x, w1_b.y)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    lineTo(w1_r.x, w1_r.y)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    lineTo(w1_tr.x, w1_tr.y)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
