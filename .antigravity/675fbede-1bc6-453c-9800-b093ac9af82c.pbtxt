          text: "                    val dotRadius = (22f / cPt.z).coerceIn(3f, 10f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    drawScope.drawCircle("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        color = color.copy(alpha = (1f - progress * 0.5f).coerceIn(0.2f, 0.9f)),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        radius = dotRadius,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
