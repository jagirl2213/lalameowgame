            center = Offset(baseScreen.x - scale * 0.18f + leanOffset * 0.5f, baseScreen.y - scale * 0.1f)\\n        )\\n        drawScope.drawCircle(\\n            color = Color(0xFFCBD5E1),\\n            radius = scale * 0.08f,\\n            center = Offset(baseScreen.x - scale * 0.18f + leanOffset * 0.5f, baseScreen.y - scale * 0.1f)\\n        )\\n\\n        // Front Wheel\\n        drawScope.drawCircle(\\n            color = Color(0xFF1E293B),\\n            radius = scale * 0.16f,\\n            center = Offset(baseScreen.x + scale * 0.18f + leanOffset * 0.5f, baseScreen.y - scale * 0.1f)\\n        )\\n        drawScope.drawCircle(\\n            color = Color(0xFFCBD5E1),\\n            radius = scale * 0.08f,\\n            center = Offset(baseScreen.x + scale * 0.18f + leanOffset * 0.5f, baseScreen.y - scale * 0.1f)\\n        )\\n\\n        // Scooter Footboard & Chassis\\n        drawScope.drawRoundRect(\\n            color = bodyColor,\\n            topLeft = Offset(baseScreen.x - scale * 0.32f + leanOffset * 0.6f, baseScreen.y - scale * 0.25f),\\n            size = Size(scale * 0.64f, scale * 0.18f),\\n            cornerRadius = CornerRadius(scale * 0.08f, scale * 0.08f)\\n        )\\n\\n        // Front Cowling / Shield\\n        drawScope.drawRoundRect(\\n            color = bodyColor,\\n            topLeft = Offset(baseScreen.x + scale * 0.05f + leanOffset * 0.8f, baseScreen.y - scale * 0.42f),\\n            size = Size(scale * 0.22f, scale * 0.25f),\\n            cornerRadius = CornerRadius(scale * 0.08f, scale * 0.08f)\\n        )\\n\\n        // Scooter Seat\\n        drawScope.drawRoundRect(\\n            color = seatColor,\\n            topLeft = Offset(baseScreen.x - scale * 0.28f + leanOffset * 0.7f, baseScreen.y - scale * 0.32f),\\n            size = Size(scale * 0.3f, scale * 0.1f),\\n            cornerRadius = CornerRadius(scale * 0.04f, scale * 0.04f)\\n        )\\n\\n        // Handlebars\\n        val steerOffset = (steeringAngleDeg / 30f) * scale * 0.15f\\n        drawScope.drawLine(\\n            color = Color(0xFF64748B),\\n            start = Offset(baseScreen.x + scale * 0.05f + leanOffset + steerOffset, baseScreen.y - scale * 0.45f),\\n            end = Offset(baseScreen.x + scale * 0.28f + leanOffset + steerOffset, baseScreen.y - scale * 0.45f),\\n            strokeWidth = scale * 0.04f\\n        )\\n        // Handlebar Grips\\n        drawScope.drawCircle(\\n            color = Color(0xFF0F172A),\\n            radius = scale * 0.035f,\\n            center = Offset(baseScreen.x + scale * 0.05f + leanOffset + steerOffset, baseScreen.y - scale * 0.45f)\\n        )\\n        drawScope.drawCircle(\\n            color = Color(0xFF0F172A),\\n            radius = scale * 0.035f,\\n            center = Offset(baseScreen.x + scale * 0.28f + leanOffset + steerOffset, baseScreen.y - scale * 0.45f)\\n        )\\n\\n        // Headlight fixture\\n        drawScope.drawCircle(\\n            color = if (isHeadlightOn) Color(0xFFFEF08A) else Color(0xFFE2E8F0),\\n            radius = scale * 0.07f,\\n            center = Offset(baseScreen.x + scale * 0.22f + leanOffset * 0.8f, baseScreen.y - scale * 0.38f)\\n        )\\n\\n        // 4. Cat Delivery Backpack\\n        val bagColor = customization.backpack.color\\n        drawScope.drawRoundRect(\\n            color = bagColor,\\n            topLeft = Offset(baseScreen.x - scale * 0.36f + leanOffset * 0.85f, baseScreen.y - scale * 0.58f),\\n            size = Size(scale * 0.22f, scale * 0.26f),\\n            cornerRadius = CornerRadius(scale * 0.05f, scale * 0.05f)\\n        )\\n        // Backpack thermal stripe\\n        drawScope.drawRoundRect(\\n            color = Color.White.copy(alpha = 0.85f),\\n            topLeft = Offset(baseScreen.x - scale * 0.36f + leanOffset * 0.85f, baseScreen.y - scale * 0.46f),\\n            size = Size(scale * 0.22f, scale * 0.04f)\\n        )\\n\\n        // 5. Cat Body & Jacket\\n        val fur = customization.furColor\\n        val jacket = customization.jacket\\n        val catBodyX = baseScreen.x - scale * 0.08f + leanOffset\\n        val catBodyY = baseScreen.y - scale * 0.45f\\n\\n        // Cat Tail (animated waving)\\n        val tailWave = sin((System.currentTimeMillis() % 1000) / 1000f * 2 * PI).toFloat()\\n        val tailPath = Path().apply {\\n            moveTo(catBodyX - scale * 0.16f, catBodyY + scale * 0.08f)\\n            quadraticTo(\\n                catBodyX - scale * 0.32f + tailWave * scale * 0.06f,\\n                catBodyY - scale * 0.05f,\\n                catBodyX - scale * 0.28f + tailWave * scale * 0.12f,\\n                catBodyY - scale * 0.22f\\n            )\\n        }\\n        drawScope.drawPath(\\n            path = tailPath,\\n            color = fur.primaryColor,\\n            style = Stroke(width = scale * 0.06f)\\n        )\\n\\n        // Cat Torso (Jacket)\\n        drawScope.drawRoundRect(\\n            color = jacket.color,\\n            topLeft = Offset(catBodyX - scale * 0.15f, catBodyY - scale * 0.15f),\\n            size = Size(scale * 0.3f, scale * 0.26f),\\n            cornerRadius = CornerRadius(scale * 0.1f, scale * 0.1f)\\n        )\\n        // Jacket Trim\\n        drawScope.drawRoundRect(\\n            color = jacket.trimColor,\\n            topLeft = Offset(catBodyX - scale * 0.03f, catBodyY - scale * 0.15f),\\n            size = Size(scale * 0.06f, scale * 0.26f)\\n        )\\n\\n        // Cat Paws on handlebars\\n        drawScope.drawCircle(\\n            color = fur.secondaryColor,\\n            radius = scale * 0.045f,\\n            center = Offset(baseScreen.x + scale * 0.08f + leanOffset + steerOffset * 0.7f, baseScreen.y - scale * 0.42f)\\n        )\\n\\n        // If celebrating delivery, raise one paw high!\\n        if (isCelebrating) {\\n            drawScope.drawCircle(\\n                color = fur.secondaryColor,\\n                radius = scale * 0.055f,\\n                center = Offset(catBodyX + scale * 0.18f, catBodyY - scale * 0.48f)\\n            )\\n        } else {\\n            drawScope.drawCircle(\\n                color = fur.secondaryColor,\\n                radius = scale * 0.045f,\\n                center = Offset(baseScreen.x + scale * 0.24f + leanOffset + steerOffset * 0.7f, baseScreen.y - scale * 0.42f)\\n            )\\n        }\\n\\n        // 6. Cat Head\\n        val headX = catBodyX + scale * 0.04f\\n        val headY = catBodyY - scale * 0.28f\\n        val headRadius = scale * 0.16f\\n\\n        // Head sphere\\n        drawScope.drawCircle(\\n            color = fur.primaryColor,\\n            radius = headRadius,\\n            center = Offset(headX, headY)\\n        )\\n\\n        // Cat Ears (3D animated twitches)\\n        val earTwitch = if (earTwitchTimer < 0.25f) sin(earTwitchTimer * 20f) * scale * 0.03f else 0f\\n        val speedWindFold = (speed / 30f).coerceIn(0f, 1f) * scale * 0.04f\\n\\n        // Left Ear\\n        val leftEar = Path().apply {\\n            moveTo(headX - headRadius * 0.8f, headY - headRadius * 0.3f)\\n            lineTo(headX - headRadius * 0.7f - speedWindFold, headY - headRadius * 1.5f + earTwitch)\\n            lineTo(headX - headRadius * 0.1f, headY - headRadius * 0.8f)\\n            close()\\n        }\\n        drawScope.drawPath(leftEar, color = fur.primaryColor)\\n        val leftInner = Path().apply {\\n            moveTo(headX - headRadius * 0.7f, headY - headRadius * 0.4f)\\n            lineTo(headX - headRadius * 0.62f - speedWindFold, headY - headRadius * 1.3f + earTwitch)\\n            lineTo(headX - headRadius * 0.2f, headY - headRadius * 0.75f)\\n            close()\\n        }\\n        drawScope.drawPath(leftInner, color = fur.earInnerColor)\\n\\n        // Right Ear\\n        val rightEar = Path().apply {\\n            moveTo(headX + headRadius * 0.1f, headY - headRadius * 0.8f)\\n            lineTo(headX + headRadius * 0.7f - speedWindFold, headY - headRadius * 1.5f - earTwitch)\\n            lineTo(headX + headRadius * 0.8f, headY - headRadius * 0.3f)\\n            close()\\n        }\\n        drawScope.drawPath(rightEar, color = fur.primaryColor)\\n        val rightInner = Path().apply {\\n            moveTo(headX + headRadius * 0.2f, headY - headRadius * 0.75f)\\n            lineTo(headX + headRadius * 0.62f - speedWindFold, headY - headRadius * 1.3f - earTwitch)\\n            lineTo(headX + headRadius * 0.7f, headY - headRadius * 0.4f)\\n            close()\\n        }\\n        drawScope.drawPath(rightInner, color = fur.earInnerColor)\\n\\n        // 7. Cat Helmet\\n        val helmet = customization.helmet\\n        if (helmet != HelmetOption.NONE_BOW) {\\n            drawScope.drawArc(\\n                color = helmet.color,\\n                startAngle = 170f,\\n                sweepAngle = 200f,\\n                useCenter = true,\\n                topLeft = Offset(headX - headRadius * 1.15f, headY - headRadius * 1.25f),\\n                size = Size(headRadius * 2.3f, headRadius * 2.1f)\\n            )\\n            // Visor / Stripe\\n            drawScope.drawArc(\\n                color = helmet.accentColor.copy(alpha = 0.85f),\\n                startAngle = 210f,\\n                sweepAngle = 120f,\\n                useCenter = false,\\n                topLeft = Offset(headX - headRadius * 1.05f, headY - headRadius * 0.95f),\\n                size = Size(headRadius * 2.1f, headRadius * 1.7f),\\n                style = Stroke(width = headRadius * 0.3f)\\n            )\\n        } else {\\n            // Cute Bow\\n            drawScope.drawCircle(\\n                color = DustyRose,\\n                radius = headRadius * 0.32f,\\n                center = Offset(headX + headRadius * 0.6f, headY - headRadius * 0.8f)\\n            )\\n            drawScope.drawCircle(\\n                color = Color.White,\\n                radius = headRadius * 0.12f,\\n                center = Offset(headX + headRadius * 0.6f, headY - headRadius * 0.8f)\\n            )\\n        }\\n\\n        // 8. Cat Face (Only visible if viewing mostly from front/side)\\n        if (relHeadingToCam in 70f..290f) {\\n            val faceDir = if (relHeadingToCam > 180f) -1f else 1f\\n\\n            // Cheeks\\n            drawScope.drawCircle(\\n                color = fur.secondaryColor,\\n                radius = headRadius * 0.45f,\\n                center = Offset(headX + headRadius * 0.2f * faceDir, headY + headRadius * 0.25f)\\n            )\\n\\n            // Blinking Eyes\\n            if (!isBlinking) {\\n                drawScope.drawCircle(\\n                    color = fur.eyeColor,\\n                    radius = headRadius * 0.18f,\\n                    center = Offset(headX + headRadius * 0.15f * faceDir, headY - headRadius * 0.05f)\\n                )\\n                drawScope.drawCircle(\\n                    color = Color.White,\\n                    radius = headRadius * 0.07f,\\n                    center = Offset(headX + headRadius * 0.12f * faceDir, headY - headRadius * 0.1f)\\n                )\\n            } else {\\n                // Closed happy curve eye\\n                drawScope.drawLine(\\n                    color = Color(0xFF0F172A),\\n                    start = Offset(headX + headRadius * 0.05f * faceDir, headY),\\n                    end = Offset(headX + headRadius * 0.28f * faceDir, headY),\\n                    strokeWidth = scale * 0.02f\\n                )\\n            }\\n\\n            // Pink Nose\\n            drawScope.drawCircle(\\n                color = DustyRose,\\n                radius = headRadius * 0.08f,\\n                center = Offset(headX + headRadius * 0.35f * faceDir, headY + headRadius * 0.15f)\\n            )\\n\\n            // Whiskers\\n            val whiskerStartX = headX + headRadius * 0.35f * faceDir\\n            val whiskerStartY = headY + headRadius * 0.18f\\n            drawScope.drawLine(\\n                color = Color(0xFF64748B),\\n                start = Offset(whiskerStartX, whiskerStartY),\\n                end = Offset(whiskerStartX + scale * 0.15f * faceDir, whiskerStartY - scale * 0.03f),\\n                strokeWidth = scale * 0.015f\\n            )\\n            drawScope.drawLine(\\n                color = Color(0xFF64748B),\\n                start = Offset(whiskerStartX, whiskerStartY + scale * 0.02f),\\n                end = Offset(whiskerStartX + scale * 0.15f * faceDir, whiskerStartY + scale * 0.05f),\\n                strokeWidth = scale * 0.015f\\n            )\\n        }\\n    }\\n}\\n\", \"Overwrite\":true, \"TargetFile\":\"/app/src/main/java/com/example/game/engine/CatRiderRenderer3D.kt\", \"toolAction\":\"Creating CatRiderRenderer3D\", \"toolSummary\":\"Create CatRiderRenderer3D.kt\"}"
