        }
        lines {
          text: "        // Front wall"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val frontWall = Path().apply {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            moveTo(b2.x, b2.y)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            lineTo(b3.x, b3.y)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            lineTo(t3.x, t3.y)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            lineTo(t2.x, t2.y)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
