        lines {
          text: "                color = Color(0x66BAE6FD),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                start = Offset(rx, ry),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                end = Offset(rx - 6f, ry + 22f),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                strokeWidth = 1.8f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
