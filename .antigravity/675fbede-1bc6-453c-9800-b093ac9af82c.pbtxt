        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // If completely behind camera near plane, skip"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            if (c1.z < 0.35f && c2.z < 0.35f && c3.z < 0.35f && c4.z < 0.35f) continue"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // If too far away, skip"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            if (c1.z > 160f && c3.z > 160f) continue"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // Clamp near z to prevent (0,0) singularities"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
