          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            radius = scale * 0.05f,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            center = Offset(handleCenterX + scale * 0.36f + steerOffset, handleY - scale * 0.14f)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Turn Signal Indicators (Amber)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val isSteeringLeft = steeringAngleDeg < -5f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val isSteeringRight = steeringAngleDeg > 5f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val blinkOn = (System.currentTimeMillis() % 400) < 200"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val leftSignalColor = if (isSteeringLeft && blinkOn) Color(0xFFF59E0B) else Color(0x66F59E0B)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val rightSignalColor = if (isSteeringRight && blinkOn) Color(0xFFF59E0B) else Color(0x66F59E0B)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        drawScope.drawCircle(leftSignalColor, radius = scale * 0.035f, center = Offset(handleCenterX - scale * 0.28f, handleY + scale * 0.05f))"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        drawScope.drawCircle(rightSignalColor, radius = scale * 0.035f, center = Offset(handleCenterX + scale * 0.28f, handleY + scale * 0.05f))"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // 8. Fluffy Cat Tail (Waving with speed and physics)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val tailSway = sin(tailAnimTime) * scale * 0.08f + leanOffset * 0.3f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val tailBaseX = centerX + leanOffset * 0.8f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val tailBaseY = chassisY - scale * 0.05f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val tailPath = Path().apply {"
