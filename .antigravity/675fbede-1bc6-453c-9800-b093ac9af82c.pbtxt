          text: "            center = Offset(handleCenterX - scale * 0.36f + steerOffset, handleY - scale * 0.14f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        drawScope.drawLine("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            color = Color(0xFF94A3B8),"
