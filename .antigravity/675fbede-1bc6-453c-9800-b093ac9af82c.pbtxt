        }
        lines {
          text: "        // Steering & Yaw"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val turnRate = (if (isDrifting) 85f else 55f) * _settings.value.controlSensitivity"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val speedFactor = (playerSpeed / baseMaxSpeed).coerceIn(-1f, 1f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        playerHeadingDeg = (playerHeadingDeg + steeringInput * turnRate * speedFactor * delta + 360f) % 360f"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Dynamic Lean Angle"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val targetLean = (steeringInput * (if (isDrifting) 32f else 20f) * speedFactor.coerceAtLeast(0.2f)).coerceIn(-35f, 35f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        playerLeanDeg += (targetLean - playerLeanDeg) * 12f * delta"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Update 3D World Position"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val radHeading = (playerHeadingDeg * PI / 180.0).toFloat()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val forwardX = sin(radHeading)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val forwardZ = cos(radHeading)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        playerX = (playerX + forwardX * playerSpeed * delta).coerceIn(-115f, 115f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        playerZ = (playerZ + forwardZ * playerSpeed * delta).coerceIn(-115f, 115f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Audio Engine update"
