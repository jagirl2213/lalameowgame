          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val baseMaxSpeed = _customization.value.scooterModel.baseSpeed + (_speedUpgradeLevel.value - 1) * 3.5f"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val baseAccel = _customization.value.scooterModel.baseAccel + (_accelUpgradeLevel.value - 1) * 3f"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val maxSpeed = if (isDrifting) baseMaxSpeed * 1.15f else baseMaxSpeed"
