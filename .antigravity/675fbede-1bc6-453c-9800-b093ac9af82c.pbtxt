        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        for (i in 0 until dotsCount) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
