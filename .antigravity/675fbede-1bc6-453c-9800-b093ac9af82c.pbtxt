        }
        lines {
          text: "            moveTo(tailBaseX, tailBaseY)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            quadraticTo("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                tailBaseX + scale * 0.22f + tailSway,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                tailBaseY - scale * 0.15f,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                tailBaseX + scale * 0.18f + tailSway * 1.5f,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                tailBaseY - scale * 0.38f"
