        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val unreadCount = messages.count { !it.isRead }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val infiniteTransition = rememberInfiniteTransition(label = \"hud_pulse\")"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val lowFuelAlpha by infiniteTransition.animateFloat("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        initialValue = 0.3f,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        targetValue = 1f,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        animationSpec = infiniteRepeatable(tween(500), RepeatMode.Reverse),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        label = \"low_fuel_pulse\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
