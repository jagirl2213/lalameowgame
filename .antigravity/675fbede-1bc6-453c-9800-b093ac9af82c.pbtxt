        lines {
          text: "        val c_t3 = camera.toCameraSpace(b.x - halfW, b.height, b.z + halfL)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        // Camera-space corners (South: -Z, North: +Z, West: -X, East: +X)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
