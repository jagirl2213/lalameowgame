          text: "        drawScope.drawPath("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            path = tailPath,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            color = fur.primaryColor,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
