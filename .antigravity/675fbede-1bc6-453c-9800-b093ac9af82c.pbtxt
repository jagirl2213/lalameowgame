        }
        lines {
          text: "                        title = \"Fuel Low Warning\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        body = \"Tank under 20%! Check your GPS radar for the nearest gas station.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
