        }
        lines {
          text: "    ) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val dx = road.endX - road.startX"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val dz = road.endZ - road.startZ"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val roadLen = kotlin.math.sqrt(dx * dx + dz * dz)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        if (roadLen <= 0.1f) return"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val halfW = road.width * 0.5f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val isHorizontal = kotlin.math.abs(dx) > kotlin.math.abs(dz)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Subdivide road into 10-unit pieces"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val steps = (roadLen / 10f).toInt().coerceAtLeast(1)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        for (s in 0 until steps) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val u0 = s.toFloat() / steps"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val u1 = (s + 1).toFloat() / steps"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val x0 = road.startX + dx * u0"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val z0 = road.startZ + dz * u0"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val x1 = road.startX + dx * u1"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val z1 = road.startZ + dz * u1"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // 4 world corners"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val w1 = if (isHorizontal) Vector3(x0, 0f, z0 - halfW) else Vector3(x0 - halfW, 0f, z0)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val w2 = if (isHorizontal) Vector3(x0, 0f, z0 + halfW) else Vector3(x0 + halfW, 0f, z0)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val w3 = if (isHorizontal) Vector3(x1, 0f, z1 + halfW) else Vector3(x1 + halfW, 0f, z1)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val w4 = if (isHorizontal) Vector3(x1, 0f, z1 - halfW) else Vector3(x1 - halfW, 0f, z1)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // Convert to camera space"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val c1 = camera.toCameraSpace(w1.x, w1.y, w1.z)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val c2 = camera.toCameraSpace(w2.x, w2.y, w2.z)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val c3 = camera.toCameraSpace(w3.x, w3.y, w3.z)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val c4 = camera.toCameraSpace(w4.x, w4.y, w4.z)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // If completely behind camera near plane, skip"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            if (c1.z < 0.35f && c2.z < 0.35f && c3.z < 0.35f && c4.z < 0.35f) continue"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // If too far away, skip"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            if (c1.z > 160f && c3.z > 160f) continue"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // Clamp near z to prevent (0,0) singularities"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val cl1 = if (c1.z < 0.35f) Vector3(c1.x, c1.y, 0.35f) else c1"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val cl2 = if (c2.z < 0.35f) Vector3(c2.x, c2.y, 0.35f) else c2"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val cl3 = if (c3.z < 0.35f) Vector3(c3.x, c3.y, 0.35f) else c3"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
