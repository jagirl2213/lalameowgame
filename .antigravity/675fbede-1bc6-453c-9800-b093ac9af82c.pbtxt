        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Building Windows (Glowing in night/sunset)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val isNight = weather == WeatherCondition.NEON_NIGHT"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val windowColor = if (isNight) Color(0xFFFEF08A) else Color(0x66FFFFFF)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val winRows = (b.height / 3.5f).toInt().coerceAtLeast(1)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        for (r in 1..winRows) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val hRatio = r.toFloat() / (winRows + 1)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val wx1 = b3.x + (t3.x - b3.x) * hRatio"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val wy1 = b3.y + (t3.y - b3.y) * hRatio"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val wx2 = b2.x + (t2.x - b2.x) * hRatio"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val wy2 = b2.y + (t2.y - b2.y) * hRatio"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            drawScope.drawLine("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                color = windowColor,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                start = Offset(wx1 + (wx2 - wx1) * 0.25f, wy1 + (wy2 - wy1) * 0.25f),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                end = Offset(wx1 + (wx2 - wx1) * 0.45f, wy1 + (wy2 - wy1) * 0.45f),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                strokeWidth = 3f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            drawScope.drawLine("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                color = windowColor,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                start = Offset(wx1 + (wx2 - wx1) * 0.55f, wy1 + (wy2 - wy1) * 0.55f),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                end = Offset(wx1 + (wx2 - wx1) * 0.75f, wy1 + (wy2 - wy1) * 0.75f),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                strokeWidth = 3f"
