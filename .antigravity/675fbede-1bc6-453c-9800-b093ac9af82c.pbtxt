        }
        lines {
          text: "                start = Offset(rx, ry),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                end = Offset(rx - 7f, ry + 24f),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                strokeWidth = 2f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
