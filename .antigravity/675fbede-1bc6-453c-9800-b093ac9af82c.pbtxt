        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val p1 = if (isHorizontal) camera.project(road.startX, 0f, road.startZ - halfW, w, h)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        else camera.project(road.startX - halfW, 0f, road.startZ, w, h)"
