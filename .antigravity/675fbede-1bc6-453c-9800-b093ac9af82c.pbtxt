        }
        lines {
          text: "            if (playerSpeed > 0f) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                playerSpeed = (playerSpeed - friction * delta).coerceAtLeast(0f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            } else if (playerSpeed < 0f) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                playerSpeed = (playerSpeed + friction * delta).coerceAtMost(0f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
