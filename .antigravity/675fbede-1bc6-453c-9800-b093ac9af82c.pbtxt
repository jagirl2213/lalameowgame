        lines {
          text: "    override fun draw(drawScope: DrawScope, camera: Camera3D, weather: WeatherCondition, pulse: Float, w: Float, h: Float) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val halfW = b.width * 0.5f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val halfL = b.length * 0.5f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
