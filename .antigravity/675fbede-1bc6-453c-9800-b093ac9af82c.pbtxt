        lines {
          text: "    private fun renderSky(drawScope: DrawScope, camera: Camera3D, weather: WeatherCondition, w: Float, h: Float) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val horizonY = h * 0.38f"
