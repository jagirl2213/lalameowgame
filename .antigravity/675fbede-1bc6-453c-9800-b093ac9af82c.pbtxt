          text: "            for (r in 1..winRows) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                val hRatio0 = (r.toFloat() - 0.2f) / (winRows + 1)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                val hRatio1 = (r.toFloat() + 0.35f) / (winRows + 1)"
