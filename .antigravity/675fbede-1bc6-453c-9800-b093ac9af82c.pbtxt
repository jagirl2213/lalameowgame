        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val p2 = if (isHorizontal) camera.project(road.startX, 0f, road.startZ + halfW, w, h)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
