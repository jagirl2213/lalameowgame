        lines {
          text: "                close()"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            drawScope.drawPath(wallPath, color = faceColor)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            drawScope.drawLine(faceColor.copy(alpha = 0.4f), Offset(p0.x, p0.y), Offset(pTop0.x, pTop0.y), strokeWidth = 2f)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            drawScope.drawLine(faceColor.copy(alpha = 0.4f), Offset(p1.x, p1.y), Offset(pTop1.x, pTop1.y), strokeWidth = 2f)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Helper to draw windows on a face"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        fun drawWindows(p0: ScreenPoint, p1: ScreenPoint, pTop1: ScreenPoint, pTop0: ScreenPoint) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val winRows = (b.height / 3.8f).toInt().coerceAtLeast(1)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val windowColor = if (isNight) Color(0xFFFEF08A) else if (isSunset) Color(0xFFFED7AA) else Color(0x99FFFFFF)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val frameColor = Color(0x44000000)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            for (r in 1..winRows) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                val hRatio0 = (r.toFloat() - 0.2f) / (winRows + 1)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                val hRatio1 = (r.toFloat() + 0.35f) / (winRows + 1)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                val w1_b = Offset(p0.x + (p1.x - p0.x) * 0.2f + (pTop0.x - p0.x) * hRatio0, p0.y + (p1.y - p0.y) * 0.2f + (pTop0.y - p0.y) * hRatio0)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
