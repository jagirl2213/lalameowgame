        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Subdivide road into 10-unit pieces"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val steps = (roadLen / 10f).toInt().coerceAtLeast(1)"
