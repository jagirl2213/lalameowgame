          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                drawScope.drawLine(Color(0xFFCBD5E1), Offset(p1.x, p1.y), Offset(p4.x, p4.y), strokeWidth = 2.5f)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                drawScope.drawLine(Color(0xFFCBD5E1), Offset(p2.x, p2.y), Offset(p3.x, p3.y), strokeWidth = 2.5f)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                // Yellow Centerline Dash"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                if (s % 2 == 0) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    val midX0 = (x0 + x1) * 0.5f - (dx / steps) * 0.2f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
