        lines {
          text: "    private fun renderGpsBreadcrumbs("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        drawScope: DrawScope,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        camera: Camera3D,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        job: DeliveryJob,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        w: Float,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        h: Float"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val targetX = if (job.state == DeliveryState.ACCEPTED) job.pickupX else job.dropoffX"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val targetZ = if (job.state == DeliveryState.ACCEPTED) job.pickupZ else job.dropoffZ"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val dotsCount = 14"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val color = if (job.state == DeliveryState.ACCEPTED) HoneyYellow else TealBrand"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        for (i in 0 until dotsCount) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val progress = ((i.toFloat() / dotsCount) + breadcrumbPhase) % 1.0f"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val dotX = camera.posX + (targetX - camera.posX) * progress"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val dotZ = camera.posZ + (targetZ - camera.posZ) * progress"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val cPt = camera.toCameraSpace(dotX, 0.15f, dotZ)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            if (cPt.z in 0.5f..80f) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
