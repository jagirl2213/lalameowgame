        }
        lines {
          text: "            color = Color(0xFFE2E8F0),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            radius = scale * 0.05f,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
