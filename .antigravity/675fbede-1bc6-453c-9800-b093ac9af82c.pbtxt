        lines {
          text: "        // Turn Signal Indicators (Amber)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val isSteeringLeft = steeringAngleDeg < -5f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val isSteeringRight = steeringAngleDeg > 5f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val blinkOn = (System.currentTimeMillis() % 400) < 200"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val leftSignalColor = if (isSteeringLeft && blinkOn) Color(0xFFF59E0B) else Color(0x66F59E0B)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val rightSignalColor = if (isSteeringRight && blinkOn) Color(0xFFF59E0B) else Color(0x66F59E0B)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        drawScope.drawCircle(leftSignalColor, radius = scale * 0.035f, center = Offset(handleCenterX - scale * 0.28f, handleY + scale * 0.05f))"
