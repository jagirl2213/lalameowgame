        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val t0 = camera.projectCameraPoint(clampPt(c_t0), w, h)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val t1 = camera.projectCameraPoint(clampPt(c_t1), w, h)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val t2 = camera.projectCameraPoint(clampPt(c_t2), w, h)"
