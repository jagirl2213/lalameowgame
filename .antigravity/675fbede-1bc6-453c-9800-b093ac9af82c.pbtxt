        }
        lines {
          text: "        // Cat Ears (3D animated twitches)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val earTwitch = if (earTwitchTimer < 0.25f) sin(earTwitchTimer * 20f) * scale * 0.03f else 0f"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val speedWindFold = (speed / 30f).coerceIn(0f, 1f) * scale * 0.04f"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Left Ear"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val leftEar = Path().apply {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            moveTo(headX - headRadius * 0.8f, headY - headRadius * 0.3f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            lineTo(headX - headRadius * 0.7f - speedWindFold, headY - headRadius * 1.5f + earTwitch)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            lineTo(headX - headRadius * 0.1f, headY - headRadius * 0.8f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            close()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        drawScope.drawPath(leftEar, color = fur.primaryColor)"
