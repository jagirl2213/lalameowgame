        lines {
          text: "        val helmet = customization.helmet"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if (helmet != HelmetOption.NONE_BOW) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            drawScope.drawArc("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                color = helmet.color,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                startAngle = 170f,"
