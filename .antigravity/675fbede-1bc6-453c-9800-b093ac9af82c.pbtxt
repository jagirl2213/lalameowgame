        }
        lines {
          text: "        soundEngine.updateEnginePitch("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            (playerSpeed / baseMaxSpeed).coerceIn(0f, 1f),"
