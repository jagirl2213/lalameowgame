        }
        lines {
          text: "            .padding(top = 10.dp, start = 12.dp, end = 12.dp),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        verticalArrangement = Arrangement.spacedBy(8.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
