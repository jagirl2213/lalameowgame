          text: "        val leftInner = Path().apply {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            moveTo(headX - headRadius * 0.7f, headY - headRadius * 0.4f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            lineTo(headX - headRadius * 0.62f - speedWindFold, headY - headRadius * 1.3f + earTwitch)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            lineTo(headX - headRadius * 0.2f, headY - headRadius * 0.75f)"
