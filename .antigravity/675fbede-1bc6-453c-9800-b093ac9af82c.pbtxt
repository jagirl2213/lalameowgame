          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        for (i in 0 until count) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val rx = ((i * 49f + rainPhase * 45f) % w)"
