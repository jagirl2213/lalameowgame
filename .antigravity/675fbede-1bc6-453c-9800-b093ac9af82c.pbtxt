        lines {
          text: "    private fun renderSubdividedRoad("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        drawScope: DrawScope,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        camera: Camera3D,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        road: RoadSegment,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
