          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Side wall (shaded for 3D depth)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
