        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        if (p1.isVisible || p2.isVisible || p3.isVisible || p4.isVisible) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
