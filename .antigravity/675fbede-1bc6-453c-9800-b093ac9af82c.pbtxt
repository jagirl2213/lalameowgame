          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        drawScope.drawPath(sideWall, color = b.wallColor.copy(alpha = 0.85f))"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
