  view_file {
    absolute_path_uri: "file:///app/src/main/java/com/example/game/engine/CityRenderer3D.kt"
    end_line: 29
    content: "package com.example.game.engine\n\nimport androidx.compose.ui.geometry.CornerRadius\nimport androidx.compose.ui.geometry.Offset\nimport androidx.compose.ui.geometry.Size\nimport androidx.compose.ui.graphics.Color\nimport androidx.compose.ui.graphics.Path\nimport androidx.compose.ui.graphics.drawscope.DrawScope\nimport androidx.compose.ui.graphics.drawscope.Fill\nimport androidx.compose.ui.graphics.drawscope.Stroke\nimport com.example.game.model.CityBuilding\nimport com.example.game.model.CityProp\nimport com.example.game.model.CityWorldData\nimport com.example.game.model.DeliveryJob\nimport com.example.game.model.DeliveryState\nimport com.example.game.model.NpcPedestrian\nimport com.example.game.model.NpcVehicle\nimport com.example.game.model.PropType\nimport com.example.game.model.WeatherCondition\nimport com.example.ui.theme.DustyRose\nimport com.example.ui.theme.HoneyYellow\nimport com.example.ui.theme.TealBrand\nimport kotlin.math.PI\nimport kotlin.math.cos\nimport kotlin.math.sin\n\n/**\n * High-performance 3D miniature city renderer for Lalameow Rider.\n * Renders roads, pastel buildings, trees, vehicles, weather, dynamic sky,\n * and delivery waypoint holograms."
    raw_content: "package com.example.game.engine\n\nimport androidx.compose.ui.geometry.CornerRadius\nimport androidx.compose.ui.geometry.Offset\nimport androidx.compose.ui.geometry.Size\nimport androidx.compose.ui.graphics.Color\nimport androidx.compose.ui.graphics.Path\nimport androidx.compose.ui.graphics.drawscope.DrawScope\nimport androidx.compose.ui.graphics.drawscope.Fill\nimport androidx.compose.ui.graphics.drawscope.Stroke\nimport com.example.game.model.CityBuilding\nimport com.example.game.model.CityProp\nimport com.example.game.model.CityWorldData\nimport com.example.game.model.DeliveryJob\nimport com.example.game.model.DeliveryState\nimport com.example.game.model.NpcPedestrian\nimport com.example.game.model.NpcVehicle\nimport com.example.game.model.PropType\nimport com.example.game.model.WeatherCondition\nimport com.example.ui.theme.DustyRose\nimport com.example.ui.theme.HoneyYellow\nimport com.example.ui.theme.TealBrand\nimport kotlin.math.PI\nimport kotlin.math.cos\nimport kotlin.math.sin\n\n/**\n * High-performance 3D miniature city renderer for Lalameow Rider.\n * Renders roads, pastel buildings, trees, vehicles, weather, dynamic sky,\n * and delivery waypoint holograms.\n */\nclass CityRenderer3D {\n\n    private var cloudOffset = 0f\n    private var rainPhase = 0f\n    private var waypointPulse = 0f\n\n    fun update(deltaSeconds: Float) {\n        cloudOffset = (cloudOffset + deltaSeconds * 2.5f) % 2000f\n        rainPhase = (rainPhase + deltaSeconds * 12f) % 100f\n        waypointPulse = (waypointPulse + deltaSeconds * 3.5f) % (2f * PI.toFloat())\n    }\n\n    fun renderCity(\n        drawScope: DrawScope,\n        camera: Camera3D,\n        weather: WeatherCondition,\n        activeJob: DeliveryJob?,\n        npcVehicles: List<NpcVehicle>,\n        npcPedestrians: List<NpcPedestrian>\n    ) {\n        val w = drawScope.size.width\n        val h = drawScope.size.height\n\n        // 1. Render Sky & Atmospheric Background\n        renderSky(drawScope, camera, weather, w, h)\n\n        // 2. Render Ground & Road Grid\n        renderGroundAndRoads(drawScope, camera, weather, w, h)\n\n        // 3. Collect 3D Renderables for Depth Sorting\n        val renderables = mutableListOf<Renderable3D>()\n\n        // Buildings\n        CityWorldData.buildings.forEach { b ->\n            val dist = camera.project(b.x, 0f, b.z, w, h).depth\n            if (dist > 1f && dist < 180f) {\n                renderables.add(BuildingRenderable(b, dist))\n            }\n        }\n\n        // Props (Trees, Streetlamps, Hydrants)\n        CityWorldData.props.forEach { prop ->\n            val dist = camera.project(prop.x, 0f, prop.z, w, h).depth\n            if (dist > 1f && dist < 140f) {\n                renderables.add(PropRenderable(prop, dist))\n            }\n        }\n\n        // NPC Vehicles\n        npcVehicles.forEach { v ->\n            val dist = camera.project(v.x, 0f, v.z, w, h).depth\n            if (dist > 1f && dist < 140f) {\n                renderables.add(NpcVehicleRenderable(v, dist))\n            }\n        }\n\n        // NPC Pedestrians\n        npcPedestrians.forEach { ped ->\n            val dist = camera.project(ped.x, 0f, ped.z, w, h).depth\n            if (dist > 1f && dist < 100f) {\n                renderables.add(PedestrianRenderable(ped, dist))\n            }\n        }\n\n        // Active Delivery Hologram Waypoints\n        if (activeJob != null) {\n            if (activeJob.state == DeliveryState.ACCEPTED) {\n                val dist = camera.project(activeJob.pickupX, 0f, activeJob.pickupZ, w, h).depth\n                if (dist > 0.5f) {\n                    renderables.add(WaypointRenderable(activeJob.pickupX, activeJob.pickupZ, HoneyYellow, \"PICKUP \360\237\223\246\", dist))\n                }\n            } else if (activeJob.state == DeliveryState.PICKED_UP) {\n                val dist = camera.project(activeJob.dropoffX, 0f, activeJob.dropoffZ, w, h).depth\n                if (dist > 0.5f) {\n                    renderables.add(WaypointRenderable(activeJob.dropoffX, activeJob.dropoffZ, DustyRose, \"DELIVER \360\237\220\276\", dist))\n                }\n            }\n        }\n\n        // Sort furthest to closest (Painter\'s Algorithm)\n        renderables.sortByDescending { it.depth }\n\n        // Render all sorted objects\n        renderables.forEach { item ->\n            item.draw(drawScope, camera, weather, waypointPulse, w, h)\n        }\n\n        // 4. Foreground Weather Effects (Rain streaks)\n        if (weather == WeatherCondition.RAINY) {\n            renderRain(drawScope, w, h)\n        }\n    }\n\n    private fun renderSky(drawScope: DrawScope, camera: Camera3D, weather: WeatherCondition, w: Float, h: Float) {\n        val horizonY = h * 0.38f + (camera.pitchDeg - 22f) * 8f\n\n        // Sky background\n        val skyColor = when (weather) {\n            WeatherCondition.SUNNY -> Color(0xFFBAE6FD)\n            WeatherCondition.GOLDEN_SUNSET -> Color(0xFFFDBA74)\n            WeatherCondition.RAINY -> Color(0xFF94A3B8)\n            WeatherCondition.NEON_NIGHT -> Color(0xFF0F172A)\n        }\n        drawScope.drawRect(\n            color = skyColor,\n            topLeft = Offset(0f, 0f),\n            size = Size(w, horizonY)\n        )\n\n        // Celestial body: Sun or Moon\n        if (weather == WeatherCondition.SUNNY || weather == WeatherCondition.GOLDEN_SUNSET) {\n            val sunY = horizonY * 0.45f\n            drawScope.drawCircle(\n                color = if (weather == WeatherCondition.SUNNY) Color(0xFFFEF08A) else Color(0xFFFB7185),\n                radius = 36f,\n                center = Offset(w * 0.78f, sunY)\n            )\n            // Soft halo\n            drawScope.drawCircle(\n                color = Color(0x33FFFFFF),\n                radius = 58f,\n                center = Offset(w * 0.78f, sunY)\n            )\n        } else if (weather == WeatherCondition.NEON_NIGHT) {\n            // Crescent Moon\n            val moonX = w * 0.8f\n            val moonY = horizonY * 0.4f\n            drawScope.drawCircle(color = Color(0xFFFEF08A), radius = 28f, center = Offset(moonX, moonY))\n            drawScope.drawCircle(color = Color(0xFF0F172A), radius = 24f, center = Offset(moonX - 8f, moonY - 4f))\n        }\n\n        // Fluffy moving clouds\n        val cloudColor = when (weather) {\n            WeatherCondition.SUNNY -> Color(0xDDFFFFFF)\n            WeatherCondition.GOLDEN_SUNSET -> Color(0xCCFCE7F3)\n            WeatherCondition.RAINY -> Color(0xBB64748B)\n            WeatherCondition.NEON_NIGHT -> Color(0x33334155)\n        }\n        for (i in 0..4) {\n            val cx = ((cloudOffset * 1.5f + i * 220f) % (w + 300f)) - 150f\n            val cy = horizonY * (0.2f + (i % 3) * 0.18f)\n            drawScope.drawRoundRect(\n                color = cloudColor,\n                topLeft = Offset(cx, cy),\n                size = Size(110f + (i * 20), 32f),\n                cornerRadius = CornerRadius(16f, 16f)\n            )\n            drawScope.drawCircle(color = cloudColor, radius = 24f, center = Offset(cx + 40f, cy + 8f))\n            drawScope.drawCircle(color = cloudColor, radius = 20f, center = Offset(cx + 75f, cy + 12f))\n        }\n\n        // Distant hills silhouette along horizon\n        val hillColor = when (weather) {\n            WeatherCondition.SUNNY -> Color(0xFF86EFAC)\n            WeatherCondition.GOLDEN_SUNSET -> Color(0xFFEA580C).copy(alpha = 0.6f)\n            WeatherCondition.RAINY -> Color(0xFF64748B)\n            WeatherCondition.NEON_NIGHT -> Color(0xFF1E293B)\n        }\n        val hillPath = Path().apply {\n            moveTo(0f, horizonY)\n            quadraticTo(w * 0.25f, horizonY - 40f, w * 0.5f, horizonY - 15f)\n            quadraticTo(w * 0.75f, horizonY - 55f, w, horizonY - 20f)\n            lineTo(w, horizonY + 2f)\n            lineTo(0f, horizonY + 2f)\n            close()\n        }\n        drawScope.drawPath(hillPath, color = hillColor)\n    }\n\n    private fun renderGroundAndRoads(drawScope: DrawScope, camera: Camera3D, weather: WeatherCondition, w: Float, h: Float) {\n        val groundColor = when (weather) {\n            WeatherCondition.SUNNY -> Color(0xFF86EFAC)\n            WeatherCondition.GOLDEN_SUNSET -> Color(0xFFD97706)\n            WeatherCondition.RAINY -> Color(0xFF475569)\n            WeatherCondition.NEON_NIGHT -> Color(0xFF064E3B)\n        }\n\n        // Base ground plane below horizon\n        val horizonY = h * 0.38f + (camera.pitchDeg - 22f) * 8f\n        drawScope.drawRect(\n            color = groundColor,\n            topLeft = Offset(0f, horizonY),\n            size = Size(w, h - horizonY)\n        )\n\n        // Render Roads\n        val roadAsphaltColor = when (weather) {\n            WeatherCondition.RAINY -> Color(0xFF1E293B) // Darker wet sheen\n            WeatherCondition.NEON_NIGHT -> Color(0xFF0F172A)\n            else -> Color(0xFF334155)\n        }\n\n        CityWorldData.roads.forEach { r ->\n            renderRoadSegment(drawScope, camera, r, roadAsphaltColor, w, h)\n        }\n    }\n\n    private fun renderRoadSegment(\n        drawScope: DrawScope,\n        camera: Camera3D,\n        road: RoadSegment,\n        color: Color,\n        w: Float,\n        h: Float\n    ) {\n        val halfW = road.width * 0.5f\n        val isHorizontal = kotlin.math.abs(road.startX - road.endX) > kotlin.math.abs(road.startZ - road.endZ)\n\n        val p1 = if (isHorizontal) camera.project(road.startX, 0f, road.startZ - halfW, w, h)\n        else camera.project(road.startX - halfW, 0f, road.startZ, w, h)\n\n        val p2 = if (isHorizontal) camera.project(road.startX, 0f, road.startZ + halfW, w, h)\n        else camera.project(road.startX + halfW, 0f, road.startZ, w, h)\n\n        val p3 = if (isHorizontal) camera.project(road.endX, 0f, road.endZ + halfW, w, h)\n        else camera.project(road.endX + halfW, 0f, road.endZ, w, h)\n\n        val p4 = if (isHorizontal) camera.project(road.endX, 0f, road.endZ - halfW, w, h)\n        else camera.project(road.endX - halfW, 0f, road.endZ, w, h)\n\n        if (p1.isVisible || p2.isVisible || p3.isVisible || p4.isVisible) {\n            val roadPath = Path().apply {\n                moveTo(p1.x, p1.y)\n                lineTo(p2.x, p2.y)\n                lineTo(p3.x, p3.y)\n                lineTo(p4.x, p4.y)\n                close()\n            }\n            drawScope.drawPath(roadPath, color = color)\n\n            // Sidewalk Curbs\n            drawScope.drawLine(Color(0xFFCBD5E1), Offset(p1.x, p1.y), Offset(p4.x, p4.y), strokeWidth = 3f)\n            drawScope.drawLine(Color(0xFFCBD5E1), Offset(p2.x, p2.y), Offset(p3.x, p3.y), strokeWidth = 3f)\n\n            // Dashed Centerline\n            val centerStart = camera.project(road.startX, 0f, road.startZ, w, h)\n            val centerEnd = camera.project(road.endX, 0f, road.endZ, w, h)\n            if (centerStart.isVisible && centerEnd.isVisible) {\n                drawScope.drawLine(\n                    color = Color(0xFFFDE047),\n                    start = Offset(centerStart.x, centerStart.y),\n                    end = Offset(centerEnd.x, centerEnd.y),\n                    strokeWidth = 2.5f\n                )\n            }\n        }\n    }\n\n    private fun renderRain(drawScope: DrawScope, w: Float, h: Float) {\n        val rainCount = 45\n        for (i in 0 until rainCount) {\n            val rx = ((i * 47f + rainPhase * 45f) % w)\n            val ry = ((i * 31f + rainPhase * 110f) % h)\n            drawScope.drawLine(\n                color = Color(0x66BAE6FD),\n                start = Offset(rx, ry),\n                end = Offset(rx - 6f, ry + 22f),\n                strokeWidth = 1.8f\n            )\n        }\n    }\n}\n\n// 3D Renderable interfaces and items for depth sorting\ninterface Renderable3D {\n    val depth: Float\n    fun draw(drawScope: DrawScope, camera: Camera3D, weather: WeatherCondition, pulse: Float, w: Float, h: Float)\n}\n\nclass BuildingRenderable(val b: CityBuilding, override val depth: Float) : Renderable3D {\n    override fun draw(drawScope: DrawScope, camera: Camera3D, weather: WeatherCondition, pulse: Float, w: Float, h: Float) {\n        val halfW = b.width * 0.5f\n        val halfL = b.length * 0.5f\n\n        // Bottom corners\n        val b0 = camera.project(b.x - halfW, 0f, b.z - halfL, w, h)\n        val b1 = camera.project(b.x + halfW, 0f, b.z - halfL, w, h)\n        val b2 = camera.project(b.x + halfW, 0f, b.z + halfL, w, h)\n        val b3 = camera.project(b.x - halfW, 0f, b.z + halfL, w, h)\n\n        // Top corners\n        val t0 = camera.project(b.x - halfW, b.height, b.z - halfL, w, h)\n        val t1 = camera.project(b.x + halfW, b.height, b.z - halfL, w, h)\n        val t2 = camera.project(b.x + halfW, b.height, b.z + halfL, w, h)\n        val t3 = camera.project(b.x - halfW, b.height, b.z + halfL, w, h)\n\n        if (!b0.isVisible && !b1.isVisible && !b2.isVisible && !b3.isVisible) return\n\n        val isNight = weather == WeatherCondition.NEON_NIGHT\n\n        // Wall colors with ambient shading\n        val frontWall = Path().apply {\n            moveTo(b2.x, b2.y)\n            lineTo(b3.x, b3.y)\n            lineTo(t3.x, t3.y)\n            lineTo(t2.x, t2.y)\n            close()\n        }\n        drawScope.drawPath(frontWall, color = b.wallColor)\n\n        val sideWall = Path().apply {\n            moveTo(b1.x, b1.y)\n            lineTo(b2.x, b2.y)\n            lineTo(t2.x, t2.y)\n            lineTo(t1.x, t1.y)\n            close()\n        }\n        // Slightly darker side wall for depth\n        drawScope.drawPath(sideWall, color = b.wallColor.copy(alpha = 0.85f))\n\n        // Roof\n        val roof = Path().apply {\n            moveTo(t0.x, t0.y)\n            lineTo(t1.x, t1.y)\n            lineTo(t2.x, t2.y)\n            lineTo(t3.x, t3.y)\n            close()\n        }\n        drawScope.drawPath(roof, color = b.roofColor)\n\n        // Shop Awning\n        if (b.awningColor != null) {\n            val awMidY = (b2.y + t2.y) * 0.5f\n            val awning = Path().apply {\n                moveTo(b3.x, awMidY)\n                lineTo(b2.x, awMidY)\n                lineTo(b2.x + (b2.x - b1.x) * 0.15f, awMidY + 12f)\n                lineTo(b3.x - (b0.x - b3.x) * 0.15f, awMidY + 12f)\n                close()\n            }\n            drawScope.drawPath(awning, color = b.awningColor)\n        }\n\n        // Glowing Windows\n        val windowColor = if (isNight) Color(0xFFFDE047) else Color(0x99BAE6FD)\n        val winCenter = camera.project(b.x, b.height * 0.45f, b.z + halfL + 0.1f, w, h)\n        if (winCenter.isVisible) {\n            val winW = (b2.x - b3.x).coerceAtLeast(10f) * 0.25f\n            drawScope.drawRoundRect(\n                color = windowColor,\n                topLeft = Offset(winCenter.x - winW * 0.5f, winCenter.y - winW * 0.4f),\n                size = Size(winW, winW * 0.8f),\n                cornerRadius = CornerRadius(4f, 4f)\n            )\n        }\n    }\n}\n\nclass PropRenderable(val p: CityProp, override val depth: Float) : Renderable3D {\n    override fun draw(drawScope: DrawScope, camera: Camera3D, weather: WeatherCondition, pulse: Float, w: Float, h: Float) {\n        val base = camera.project(p.x, 0f, p.z, w, h)\n        if (!base.isVisible) return\n\n        val scale = (h * 0.45f / depth).coerceIn(4f, 60f) * p.scale\n\n        when (p.type) {\n            PropType.TREE -> {\n                // Tree trunk\n                drawScope.drawRoundRect(\n                    color = Color(0xFF78350F),\n                    topLeft = Offset(base.x - scale * 0.08f, base.y - scale * 0.6f),\n                    size = Size(scale * 0.16f, scale * 0.6f),\n                    cornerRadius = CornerRadius(scale * 0.04f, scale * 0.04f)\n                )\n                // Cute round pastel foliage\n                val leafColor = if (weather == WeatherCondition.GOLDEN_SUNSET) Color(0xFFF97316) else Color(0xFF22C55E)\n                drawScope.drawCircle(\n                    color = leafColor,\n                    radius = scale * 0.42f,\n                    center = Offset(base.x, base.y - scale * 0.85f)\n                )\n                drawScope.drawCircle(\n                    color = leafColor.copy(alpha = 0.8f),\n                    radius = scale * 0.32f,\n                    center = Offset(base.x - scale * 0.15f, base.y - scale * 0.95f)\n                )\n            }\n            PropType.STREETLAMP -> {\n                // Lamp pole\n                drawScope.drawLine(\n                    color = Color(0xFF475569),\n                    start = Offset(base.x, base.y),\n                    end = Offset(base.x, base.y - scale * 0.9f),\n                    strokeWidth = scale * 0.06f\n                )\n                // Lamp lantern\n                val lampColor = if (weather == WeatherCondition.NEON_NIGHT || weather == WeatherCondition.GOLDEN_SUNSET) {\n                    Color(0xFFFEF08A)\n                } else {\n                    Color(0xFFE2E8F0)\n                }\n                drawScope.drawCircle(color = lampColor, radius = scale * 0.15f, center = Offset(base.x, base.y - scale * 0.9f))\n                if (weather == WeatherCondition.NEON_NIGHT) {\n                    // Soft light cone\n                    drawScope.drawCircle(color = Color(0x33FDE047), radius = scale * 0.55f, center = Offset(base.x, base.y - scale * 0.9f))\n                }\n            }\n            PropType.FIRE_HYDRANT -> {\n                drawScope.drawRoundRect(\n                    color = Color(0xFFEF4444),\n                    topLeft = Offset(base.x - scale * 0.1f, base.y - scale * 0.3f),\n                    size = Size(scale * 0.2f, scale * 0.3f),\n                    cornerRadius = CornerRadius(scale * 0.05f, scale * 0.05f)\n                )\n            }\n            PropType.BENCH -> {\n                drawScope.drawRoundRect(\n                    color = Color(0xFF854D0E),\n                    topLeft = Offset(base.x - scale * 0.25f, base.y - scale * 0.15f),\n                    size = Size(scale * 0.5f, scale * 0.15f),\n                    cornerRadius = CornerRadius(scale * 0.04f, scale * 0.04f)\n                )\n            }\n            PropType.FLOWER_POT -> {\n                drawScope.drawCircle(color = DustyRose, radius = scale * 0.16f, center = Offset(base.x, base.y - scale * 0.1f))\n                drawScope.drawCircle(color = HoneyYellow, radius = scale * 0.08f, center = Offset(base.x, base.y - scale * 0.18f))\n            }\n            PropType.PUDDLE -> {\n                drawScope.drawOval(\n                    color = Color(0x5538BDF8),\n                    topLeft = Offset(base.x - scale * 0.35f, base.y - scale * 0.08f),\n                    size = Size(scale * 0.7f, scale * 0.16f)\n                )\n            }\n        }\n    }\n}\n\nclass NpcVehicleRenderable(val v: NpcVehicle, override val depth: Float) : Renderable3D {\n    override fun draw(drawScope: DrawScope, camera: Camera3D, weather: WeatherCondition, pulse: Float, w: Float, h: Float) {\n        val base = camera.project(v.x, 0f, v.z, w, h)\n        if (!base.isVisible) return\n\n        val scale = (h * 0.45f / depth).coerceIn(6f, 80f)\n\n        // Shadow\n        drawScope.drawOval(\n            color = Color(0x55000000),\n            topLeft = Offset(base.x - scale * 0.4f, base.y - scale * 0.15f),\n            size = Size(scale * 0.8f, scale * 0.3f)\n        )\n\n        // Cute rounded car body\n        drawScope.drawRoundRect(\n            color = v.color,\n            topLeft = Offset(base.x - scale * 0.35f, base.y - scale * 0.32f),\n            size = Size(scale * 0.7f, scale * 0.24f),\n            cornerRadius = CornerRadius(scale * 0.1f, scale * 0.1f)\n        )\n        // Cabin\n        drawScope.drawRoundRect(\n            color = Color.White.copy(alpha = 0.85f),\n            topLeft = Offset(base.x - scale * 0.2f, base.y - scale * 0.5f),\n            size = Size(scale * 0.4f, scale * 0.22f),\n            cornerRadius = CornerRadius(scale * 0.08f, scale * 0.08f)\n        )\n        // Headlights\n        drawScope.drawCircle(color = Color(0xFFFEF08A), radius = scale * 0.06f, center = Offset(base.x + scale * 0.3f, base.y - scale * 0.2f))\n    }\n}\n\nclass PedestrianRenderable(val ped: NpcPedestrian, override val depth: Float) : Renderable3D {\n    override fun draw(drawScope: DrawScope, camera: Camera3D, weather: WeatherCondition, pulse: Float, w: Float, h: Float) {\n        val hopY = kotlin.math.abs(sin(ped.walkPhase)) * 0.3f\n        val base = camera.project(ped.x, hopY, ped.z, w, h)\n        if (!base.isVisible) return\n\n        val scale = (h * 0.35f / depth).coerceIn(6f, 60f)\n\n        // Pedestrian body (cute circle)\n        drawScope.drawCircle(\n            color = Color.White,\n            radius = scale * 0.22f,\n            center = Offset(base.x, base.y - scale * 0.35f)\n        )\n        // Emoji avatar tag\n        drawScope.drawCircle(\n            color = HoneyYellow.copy(alpha = 0.3f),\n            radius = scale * 0.28f,\n            center = Offset(base.x, base.y - scale * 0.35f)\n        )\n    }\n}\n\nclass WaypointRenderable(\n    val wx: Float,\n    val wz: Float,\n    val color: Color,\n    val label: String,\n    override val depth: Float\n) : Renderable3D {\n    override fun draw(drawScope: DrawScope, camera: Camera3D, weather: WeatherCondition, pulse: Float, w: Float, h: Float) {\n        val base = camera.project(wx, 0f, wz, w, h)\n        if (!base.isVisible) return\n\n        val scale = (h * 0.5f / depth).coerceIn(12f, 160f)\n\n        // Animated vertical beam from sky down to ground\n        val top = camera.project(wx, 16f, wz, w, h)\n        if (top.isVisible) {\n            val beam = Path().apply {\n                moveTo(base.x - scale * 0.25f, base.y)\n                lineTo(top.x - scale * 0.05f, top.y)\n                lineTo(top.x + scale * 0.05f, top.y)\n                lineTo(base.x + scale * 0.25f, base.y)\n                close()\n            }\n            drawScope.drawPath(beam, color = color.copy(alpha = 0.28f))\n        }\n\n        // Concentric expanding pulse rings on the road\n        val pulseRingScale = 1f + (sin(pulse) * 0.3f)\n        drawScope.drawOval(\n            color = color.copy(alpha = 0.65f),\n            topLeft = Offset(base.x - scale * 0.6f * pulseRingScale, base.y - scale * 0.2f * pulseRingScale),\n            size = Size(scale * 1.2f * pulseRingScale, scale * 0.4f * pulseRingScale),\n            style = Stroke(width = scale * 0.08f)\n        )\n\n        // Floating bouncing diamond / paw marker\n        val bounceY = 2.5f + sin(pulse) * 0.6f\n        val markerCenter = camera.project(wx, bounceY, wz, w, h)\n        if (markerCenter.isVisible) {\n            val diamond = Path().apply {\n                moveTo(markerCenter.x, markerCenter.y - scale * 0.32f)\n                lineTo(markerCenter.x + scale * 0.22f, markerCenter.y)\n                lineTo(markerCenter.x, markerCenter.y + scale * 0.32f)\n                lineTo(markerCenter.x - scale * 0.22f, markerCenter.y)\n                close()\n            }\n            drawScope.drawPath(diamond, color = color)\n            drawScope.drawCircle(\n                color = Color.White,\n                radius = scale * 0.09f,\n                center = Offset(markerCenter.x, markerCenter.y)\n            )\n        }\n    }\n}\n"
    num_lines: 571
    num_bytes: 22937
  }
}
