        }
        lines {
          text: "    private fun updateCamera(delta: Float) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val radH = (playerHeadingDeg * PI / 180.0).toFloat()"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val camMode = _settings.value.cameraMode"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val camDist = camMode.distance + (playerSpeed / 15f)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val camHeight = if (camMode == CameraMode.NAVIGATION_CAM) 8.5f else 4.5f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val targetCamX = playerX - sin(radH) * camDist"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val targetCamZ = playerZ - cos(radH) * camDist"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val targetCamY = camHeight"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Smooth camera spring"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        camera.posX += (targetCamX - camera.posX) * 10f * delta"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        camera.posY += (targetCamY - camera.posY) * 8f * delta"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        camera.posZ += (targetCamZ - camera.posZ) * 10f * delta"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        var targetYaw = playerHeadingDeg"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        if (camMode == CameraMode.FREE_LOOK) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            targetYaw += freeLookYawOffset"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        } else if (camMode == CameraMode.CINEMATIC) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            freeLookYawOffset = (freeLookYawOffset + delta * 25f) % 360f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            targetYaw += freeLookYawOffset"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val diffYaw = ((targetYaw - camera.yawDeg + 540f) % 360f) - 180f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        camera.yawDeg = (camera.yawDeg + diffYaw * (10f * delta).coerceAtMost(1f)) % 360f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        if (camera.yawDeg < 0f) camera.yawDeg += 360f"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        camera.pitchDeg = camMode.pitchDeg"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        camera.fov = camMode.fov"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
